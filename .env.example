# PostgreSQL
POSTGRES_DB=pegmatite_vault
POSTGRES_USER=pegmatite
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# FastAPI / SQLAlchemy
DATABASE_URL=postgresql+psycopg://pegmatite:change-me@localhost:5433/pegmatite_vault
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Image storage
IMAGE_STORAGE_ROOT=./storage
RUNTIME_SETTINGS_FILE=./storage/runtime-settings.json
IMAGE_MAX_UPLOAD_BYTES=20971520
IMAGE_DISPLAY_MAX_PX=1920
IMAGE_THUMBNAIL_MAX_PX=480

# Vite
VITE_API_BASE_URL=http://localhost:8000/api
